{
  "Focus": {
    "Ring": {
      "$type": "effect",
      "$value": [
        {
          "type": "dropShadow",
          "color": "{accent.base}",
          "offsetX": 0,
          "offsetY": 0,
          "blur": 0,
          "spread": 4
        },
        {
          "type": "dropShadow",
          "color": "{separator.base}",
          "offsetX": 0,
          "offsetY": 0,
          "blur": 0,
          "spread": 2
        }
      ],
      "$figmaStyle": "聚焦 Focus/焦点环 Ring",
      "$description": "通用焦点环:accent/base spread 4 外环 + separator/base spread 2 内环(内环制造留白)。2026-08-01 已在 Figma 建为效果样式并绑变量;Checkbox 的 focus 六档已绑。原记录第二层写 background.secondary #F5F5F5,与 Figma 实测不符,按实测(separator/base 黑 10%)校正。"
    },
    "Field": {
      "$type": "effect",
      "$value": [
        {
          "type": "dropShadow",
          "color": "{accent.base}",
          "offsetX": 0,
          "offsetY": 0,
          "blur": 0,
          "spread": 2
        }
      ],
      "$figmaStyle": "聚焦 Focus/输入聚焦 Field",
      "$description": "输入类控件聚焦:accent/base spread 2 单环,不带内环留白(输入框本身已有描边)。2026-08-01 已在 Figma 建为效果样式并绑变量;InputOTP 的 focus 两档已绑。"
    },
    "$note": "效果颜色只能绑变量、不能绑颜色样式(Figma 限制),所以这两个效果样式内部绑的是 accent/base 与 separator/base 变量。"
  },
